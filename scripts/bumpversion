#!/usr/bin/env python3
"""bumpversion — multi-target version bumper.

Increments the version in every version-tracking file for the current
repo AND validates the version is consistent across all release targets
that apply to this repo. Refuses to run if any target disagrees (drift
detection).

Release targets handled:
  python  (PyPI)       — pyproject.toml [project] version  +  src/.../__version__.py
  npm                   — package.json "version"
  github (tag + release) — validates vX.Y.Z tag exists on origin and a
                            GitHub release exists for the previous version
                            (offline check via `git ls-remote --tags origin`)

Repos known (auto-detected by inspecting pyproject.toml name / package.json name):
  memini-ai-dev                : python  →  PyPI + GH release
  boomerang-queue              : python  →  PyPI
  boomerang-proxy              : python  →  PyPI
  doc2png                      : python  →  PyPI
  @veedubin/boomerang-v3       : npm     →  NPM + GH release
  @veedubin/neuralgentics      : npm     →  NPM + GH release
  @veedubin/super-memory-ts    : npm     →  NPM + GH release
  @fangjunjie/ssh-mcp-server   : npm     →  NPM + GH release
  attacklm-dataset             : python  →  GH release (no PyPI; data bundle)
  attacklm                     : python  →  PyPI (Hatchling dynamic version)

#   neuralgentics-web            : python (pyproject) + changelog  ->  PyPI + GH
#   neuralgentics-gateway        : changelog (Go repo, no code version)  ->  GH
#   neuralgentics-broker         : changelog (Go repo, no code version)  ->  GH
#
# Changelog-canonical repos (Go repos with no version in code, or Python
# repos that ALSO track a CHANGELOG.md) use the first "## [X.Y.Z] <sep>
# YYYY-MM-DD" heading as the version source. Both hyphen "-" and em-dash
# "—" separators are accepted when reading; write_version only swaps the
# version inside the brackets (the date and separator are preserved).
#
# Go repo autodetect: when a directory has a go.mod file but neither a
# pyproject.toml nor a package.json (the Go repos neuralgentics-gateway
# and neuralgentics-broker), detect_repo parses the `module <path>` line
# and matches it against each registry entry's `go_mod_match` substring.
# This makes Go repos detectable from arbitrarily-named clones (e.g.
# /tmp/neuralgentics-extract-neuralgentics-broker) without relying on the
# clone directory name matching the registry's `subdir` field.

To add a new repo, append a RepoConfig entry. To add a new file to
an existing repo, add a FileSpec to that repo's files list.

Usage:
  bumpversion                        # show current version + drift check
  bumpversion --patch                # show what would change (dry-run)
  bumpversion --minor --apply        # bump minor and write
  bumpversion --major --apply        # bump major and write
  bumpversion --check                # exit 1 if any target disagrees
  bumpversion --list                 # show known files + targets for repo
  bumpversion --repo /path/to/repo   # specify repo (default: cwd)
  bumpversion --audit                # deep audit: compare local vs tag vs PyPI vs NPM
  bumpversion --no-network          # skip PyPI/NPM API calls during --audit

Safety:
  - Refuses to run on a dirty git working tree
  - Refuses to run if any known file is missing
  - Refuses to bump if files disagree (drift detection)
  - Default = dry-run; --apply required to write
  - Prints a diff (old -> new) before writing
  - --audit requires network only for the actual API calls (offline by default)
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path
from typing import NoReturn, Pattern

# ---------------------------------------------------------------------------
# Repo registry
# ---------------------------------------------------------------------------
#
# Each repo has:
#   name              : the pyproject.toml `name = "..."` or
#                       package.json `"name": "..."` value (for autodetect)
#   detect_marker     : substring that MUST be present in the matching
#                       file to confirm this registry entry applies
#                       (e.g. "memini-ai-dev" in package name, or
#                        "name = "memini-ai-dev"" in pyproject.toml)
#   canonical         : the relative path to the file that DEFINES the
#                       version (also the FIRST file in the files list)
#   files             : list[FileSpec] — all files to bump in lockstep
#   release_targets   : set of {python, npm, github} — which targets apply
#   pypi_name         : PyPI project name (only if "python" in targets)
#   npm_name          : NPM package name (only if "npm" in targets)
#   github_repo       : "owner/repo" (only if "github" in targets)
# ---------------------------------------------------------------------------


@dataclass
class FileSpec:
    """How to find and replace the version in a single file."""

    relpath: str
    # Regex with one capture group for the X.Y.Z version string.
    # The script replaces the captured group with the new version.
    # Use re.MULTILINE so ^ and $ match per-line.
    pattern: Pattern[str]
    # Replacement template. {version} is substituted with the new
    # version string. Default keeps surrounding context and inserts
    # the new version in the same position.
    replacement: str = r"\g<1>{version}\g<2>"


@dataclass
class RepoConfig:
    name: str
    canonical: str
    files: list[FileSpec] = field(default_factory=list)
    # Auto-detect: substring of pyproject.toml `name = "..."` or
    # package.json `"name": "..."` value
    name_match: str = ""
    # Optional: path to a marker file that confirms this is the right repo
    # (e.g. "memini-ai-dev/pyproject.toml" for the memini-ai-dev repo)
    marker_file: str | None = None
    # Optional: substring of the go.mod `module <path>` line, used to
    # autodetect Go repos that have no pyproject.toml/package.json name
    # to anchor on. When set, detect_repo reads cwd/go.mod (if present)
    # and matches the parsed module path against this substring. Empty
    # for non-Go repos (no go.mod detection).
    go_mod_match: str = ""
    # Optional: subdirectory of the workspace root where the repo lives.
    # If set, when the user invokes bumpversion from the workspace root,
    # all file paths in `files` are interpreted relative to this subdir.
    # When invoked from inside that subdir, paths are used as-is.
    subdir: str | None = None
    # Release targets
    pypi_name: str | None = None
    npm_name: str | None = None
    github_repo: str | None = None

    @property
    def release_targets(self) -> set[str]:
        t: set[str] = set()
        if self.pypi_name:
            t.add("python")
        if self.npm_name:
            t.add("npm")
        if self.github_repo:
            t.add("github")
        return t

    def relpath_for(self, abs_cwd: Path) -> str:
        """Return the path prefix-stripped to the repo root.

        If a `subdir` is set AND the cwd equals the parent of that subdir,
        the subdir prefix is removed from file paths. Otherwise paths are
        used as-is (we're already inside the repo).
        """
        if self.subdir is None:
            return ""  # no prefix to strip
        # If cwd ends with subdir (i.e. we're inside it), no stripping needed
        if abs_cwd.name == self.subdir:
            return ""
        # If cwd's parent contains subdir as a sibling, no stripping
        # (we're in a different repo entirely)
        if (abs_cwd / self.subdir).is_dir():
            return ""  # cwd is the workspace root — paths are subdir/file
        return ""

    def abs_path(self, abs_cwd: Path, relpath: str) -> Path:
        """Resolve a file relpath against the actual repo root."""
        prefix = self.relpath_for(abs_cwd)
        if prefix:
            return abs_cwd / prefix / relpath
        return abs_cwd / relpath


# ---------------------------------------------------------------------------
# File patterns
# ---------------------------------------------------------------------------

# Python: __version__ = "X.Y.Z"
PY_VERSION_PY = re.compile(
    r'^(__version__\s*=\s*")'  # group 1: prefix
    r"(\d+\.\d+\.\d+)"  # group 2: version
    r'(")',  # group 3: suffix
    re.MULTILINE,
)

# Python: pyproject.toml [project] version = "X.Y.Z"
PY_PYPROJECT = re.compile(
    r'^(version\s*=\s*")'  # group 1: prefix
    r"(\d+\.\d+\.\d+)"  # group 2: version
    r'(")',  # group 3: suffix
    re.MULTILINE,
)

# NPM: package.json "version": "X.Y.Z"
NPM_PACKAGE_JSON = re.compile(
    r'("version"\s*:\s*")'  # group 1: prefix
    r"(\d+\.\d+\.\d+)"  # group 2: version
    r'(")',  # group 3: suffix
)

# Changelog: first "## [X.Y.Z] <sep> DATE" heading.
# Accepts both hyphen "-" and em-dash "—" as the date separator (the
# neuralgentics-web repo uses "—" while the Go repos use "-").
# `re.search` returns the FIRST match, so this always reads the most
# recent (top-most) release heading. The replacement template only
# swaps the version inside the brackets; the date and separator are
# preserved untouched (release notes / new dated headings are written
# by humans — bumpversion just keeps the version string in lockstep).
CHANGELOG_HEADING = re.compile(
    r"^(##\s*\[)"  # group 1: prefix "## ["
    r"(\d+\.\d+\.\d+)"  # group 2: version
    r"(\]"  # group 3: closing "]" + optional sep + date
    r"[ \t]*[-—][ \t]*"  # separator: hyphen or em-dash, with spaces
    r"\d{4}-\d{2}-\d{2})",  # the YYYY-MM-DD date
    re.MULTILINE,
)


# ---------------------------------------------------------------------------
# Helper: build a RepoConfig from a small dict (less boilerplate below)
# ---------------------------------------------------------------------------


def _py(
    name: str,
    subdir: str,
    canonical_file: str,
    version_py_rel: str | None = None,
    pyproject_rel: str = "pyproject.toml",
    pypi_name: str | None = None,
    github_repo: str | None = None,
    marker_file: str | None = None,
) -> RepoConfig:
    """Build a Python-only repo config.

    Args:
        name: registry name (used for autodetect)
        subdir: workspace-relative directory of the repo
        canonical_file: file relpath to the canonical version source
                       (relative to the repo root, e.g. 'pyproject.toml')
        version_py_rel: file relpath to __version__.py, or None if
                        the version is only in pyproject.toml
        pyproject_rel: file relpath to pyproject.toml
        pypi_name: PyPI project name (or None)
        github_repo: GitHub owner/repo (or None)
        marker_file: workspace-root-relative path to a unique marker file
    """
    files: list[FileSpec] = []
    if version_py_rel is not None:
        files.append(
            FileSpec(
                relpath=version_py_rel,
                pattern=PY_VERSION_PY,
                replacement=r"\g<1>{version}\g<3>",
            )
        )
    files.append(
        FileSpec(
            relpath=pyproject_rel,
            pattern=PY_PYPROJECT,
            replacement=r"\g<1>{version}\g<3>",
        )
    )
    return RepoConfig(
        name=name,
        canonical=canonical_file,
        name_match=name,
        marker_file=marker_file,
        subdir=subdir,
        pypi_name=pypi_name,
        github_repo=github_repo,
        files=files,
    )


def _npm(
    name: str,
    subdir: str,
    canonical_file: str = "package.json",
    npm_name: str | None = None,
    github_repo: str | None = None,
    marker_file: str | None = None,
) -> RepoConfig:
    """Build an NPM-only repo config."""
    return RepoConfig(
        name=name,
        canonical=canonical_file,
        name_match=name,
        marker_file=marker_file,
        subdir=subdir,
        npm_name=npm_name,
        github_repo=github_repo,
        files=[
            FileSpec(
                relpath=canonical_file,
                pattern=NPM_PACKAGE_JSON,
                replacement=r"\g<1>{version}\g<3>",
            ),
        ],
    )


def _changelog(
    name: str,
    subdir: str,
    *,
    canonical_file: str = "CHANGELOG.md",
    changelog_rel: str = "CHANGELOG.md",
    pypi_name: str | None = None,
    github_repo: str | None = None,
    marker_file: str | None = None,
    go_mod_match: str = "",
    extra_files: list[FileSpec] | None = None,
) -> RepoConfig:
    """Build a RepoConfig for a changelog-canonical repo (Go repos, or
    any repo whose version source of truth is the first CHANGELOG.md
    release heading).

    The CHANGELOG.md heading is the canonical version source. The
    `changelog_rel` file is bumped in lockstep with the canonical file
    (defaults to the same file, so only one file is tracked unless
    `extra_files` adds more — e.g. a pyproject.toml for a Python repo
    that ALSO keeps a CHANGELOG).

    Args:
        name: registry name (also used for autodetect via name_match)
        subdir: directory name of the repo (used for ancestor fallback
                in detect_repo; for /tmp clones outside the workspace
                root this is the dir name bumpversion is run from)
        canonical_file: relpath to the canonical CHANGELOG.md
        changelog_rel: relpath to the changelog FileSpec (defaults to
                       canonical_file so only one file is tracked)
        pypi_name: PyPI project name (or None)
        github_repo: GitHub owner/repo (or None)
        marker_file: workspace-root-relative marker (or None for repos
                     outside the workspace root — autodetect then relies
                     on name_match / subdir ancestor fallback)
        extra_files: additional FileSpecs to bump in lockstep (e.g. a
                     pyproject.toml for a Python repo that also tracks
                     a CHANGELOG)
    """
    files: list[FileSpec] = [
        FileSpec(
            relpath=changelog_rel,
            pattern=CHANGELOG_HEADING,
            replacement=r"\g<1>{version}\g<3>",
        )
    ]
    if extra_files:
        files.extend(extra_files)
    return RepoConfig(
        name=name,
        canonical=canonical_file,
        name_match=name,
        marker_file=marker_file,
        go_mod_match=go_mod_match,
        subdir=subdir,
        pypi_name=pypi_name,
        github_repo=github_repo,
        files=files,
    )


